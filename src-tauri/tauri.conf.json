{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WH3 Mod Manager",
  "version": "2.2.3",
  "identifier": "com.wh3.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Total War: WARHAMMER III Mod Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QkIwQzYzRkM4MDUyODgKUldTSVVvRDhZd3k3YUJva1NkTnl1UmNHM2NtRFV2bzU0b1U0Zk1aSzV5S3c5dGJvQ2cxVjJmSjYK",
      "endpoints": [
        "https://github.com/Leinonen96/CustomModManagerWarhammer3/releases/latest/download/latest.json"
      ]
    }
  }
}
