{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WH3 Mod Manager",
  "version": "2.0.0",
  "identifier": "com.wh3.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Total War: WARHAMMER III Mod Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
